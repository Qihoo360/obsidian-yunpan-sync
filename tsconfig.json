{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "lib": ["DOM", "ES2022"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "esbuild.config.mjs"]
}
