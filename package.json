{
  "name": "obsidian-yunpan-sync",
  "version": "1.0.7",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check:public": "node scripts/check-public.mjs",
    "verify": "npm run check:public && npm test && npm run build && npm run check:public",
    "check:release": "node scripts/check-public.mjs --release"
  },
  "dependencies": {
    "sql.js": "1.13.0"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/sql.js": "1.4.9",
    "@vitest/coverage-v8": "3.2.4",
    "esbuild": "0.25.10",
    "obsidian": "1.11.4",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "license": "MIT"
}
